NODE_ENV=development
PORT=5007

DATABASE_URL=mongodb://localhost:27017/jamii

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5012
# Set in production to the deployed frontend origin, no trailing slash. This is
# also the origin the Socket.IO handshake accepts — a wrong value breaks
# real-time while leaving the REST API working.
PROD_FRONTEND_URL=
