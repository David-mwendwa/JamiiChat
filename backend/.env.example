NODE_ENV=development
PORT=5007

DATABASE_URL=mongodb://localhost:27017/jamii

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5012
# Set in production to the deployed frontend origin, no trailing slash. This is
# also the origin the Socket.IO handshake accepts — a wrong value breaks
# real-time while leaving the REST API working.
PROD_FRONTEND_URL=

# Email (password reset). See utils/mailer.js for routing rules — a
# deliverable address goes through SMTP_*, anything else (demo/reserved
# domains) goes to the Mailtrap sandbox below so nothing bounces for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_EMAIL=
SMTP_FROM_EMAIL=noreply@jamii.app
SMTP_FROM_NAME=JamiiChat
MAIL_MODE=auto
MAIL_SANDBOX_DOMAINS=
# Mailtrap sandbox inbox — sign up free at mailtrap.io, host/port default below.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# Avatars, covers, post images and voice notes. See middleware/upload.js —
# uploads go to Cloudinary when this is fully set, and fall back to local disk
# (backend/public/media/) otherwise. Local disk is fine for dev; on an
# ephemeral host (Render) anything written there is lost on the next deploy,
# which is exactly when these should be filled in.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jamiichat
